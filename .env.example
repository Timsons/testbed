# Copy this file to .env and fill in what you need. Every variable here is
# optional — the app runs fine with none of them set.

# Port the Express server listens on. Most hosts (Render included) set this
# automatically; only set it yourself for local overrides.
PORT=3001

# Discord incoming webhook URL. When set, marking a test run result as
# "failed" posts an alert to this webhook. Leave unset to disable alerts —
# nothing breaks, the app just skips sending them.
# Create one via a Discord channel's Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# Overrides the base URL used to build the "Run: <link>" in that Discord
# alert. Leave unset — it defaults to the host that served the request, which
# is correct on any deploy target. Only set this if you're serving the app
# from a different public URL than the one the server actually receives
# requests on (e.g. a CDN or proxy that rewrites the Host header).
APP_BASE_URL=
